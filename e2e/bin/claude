#!/usr/bin/env bash
# Stand-in for `claude` in end-to-end tests: echoes input, and on "work"
# shows Claude Code's busy line ("esc to interrupt") for a few seconds.
# tmux names the pane after argv[0]; re-exec so it reports "claude", not "bash"
if [[ -z ${FAKE_CLAUDE_INNER:-} ]]; then
  FAKE_CLAUDE_INNER=1 exec -a claude bash "$0" "$@"
fi
# Fire a Claude Code hook the way the real CLI does: JSON on stdin of
# `claude-hub hook`, with TMUX_PANE in the environment (set by tmux).
hook() { # event [tool] [ntype] [message]
  printf '{"hook_event_name":"%s","session_id":"fake-1","transcript_path":"%s","tool_name":"%s","notification_type":"%s","message":"%s","tool_input":{"command":"secret"}}' \
    "$1" "$TRANSCRIPT" "${2:-}" "${3:-}" "${4:-}" | "$CLAUDE_HUB_BIN" hook
}
TRANSCRIPT="$CLAUDE_HUB_DATA/fake-transcript.jsonl"
echo "fake claude ready"
printf '> '
while IFS= read -r line; do
  echo "got: $line"
  if [[ $line == copy* ]]; then         # what Claude Code does on copy inside tmux
    printf 'hub copy 复制测试' | tmux load-buffer -w -
    echo "Copied to clipboard"
  elif [[ $line == hwork* ]]; then      # a turn reported through hooks
    hook UserPromptSubmit
    echo "✻ Working… (esc to interrupt)"
    hook PreToolUse Bash
    sleep 4
    hook PostToolUse Bash
    # 170k of a 200k window = 85%
    echo '{"type":"ai-title","aiTitle":"假任务标题"}' >> "$TRANSCRIPT"
    echo '{"type":"assistant","message":{"model":"claude-fake","content":[{"type":"text","text":"做完了：假回复"}],"usage":{"input_tokens":10,"cache_read_input_tokens":160000,"cache_creation_input_tokens":9990,"output_tokens":0}}}' >> "$TRANSCRIPT"
    hook Stop
    clear
    echo "finished"
  elif [[ $line == hask* ]]; then       # a permission prompt
    hook UserPromptSubmit
    hook PermissionRequest Bash
    printf '%s\n' "────────────────────" " Bash command" " touch hello.txt" " Do you want to proceed?" " ❯ 1. Yes" \
      "   2. Yes, and always allow access to /tmp/x" "      from this project" "   3. No" "" " Esc to cancel"
    IFS= read -r -n1 answer   # Claude Code picks an option on its number key
    echo
    hook PostToolUse Bash
    hook Stop
    clear
    echo "answered: $answer"
  elif [[ $line == work* ]]; then       # screen only, no hooks
    echo "✻ Working… (esc to interrupt)"
    sleep 6
    clear
    echo "finished"
  fi
  printf '> '
done
