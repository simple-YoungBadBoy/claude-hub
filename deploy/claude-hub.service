[Unit]
Description=Claude Hub (tmux Claude sessions + poker + pet over Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=%h/claude-hub/bin/claude-hub
Restart=always
RestartSec=3
# tmux attach clients and, if the hub happened to start it, the tmux server
# itself live in this cgroup. Only stop the hub on restart: killing the whole
# cgroup would take every tmux session (and the Claude running the deploy) down.
KillMode=process
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8

[Install]
WantedBy=default.target
