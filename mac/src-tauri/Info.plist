<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hub is plain HTTP inside the Tailscale tunnel (already encrypted by WireGuard). -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <!-- NOTE: do not add NSAllowsLocalNetworking / ...InWebContent here: when present,
         macOS ignores NSAllowsArbitraryLoads and blocks http:// to *.ts.net. -->
    <key>NSExceptionDomains</key>
    <dict>
      <key>ts.net</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
